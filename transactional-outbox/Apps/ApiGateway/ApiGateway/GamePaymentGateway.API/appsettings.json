{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "games-route": {
        "ClusterId": "game-cluster",
        "Match": {
          "Path": "/games-api/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/Game/{**catch-all}" }
        ]
      },
      "payments-route": {
        "ClusterId": "payment-cluster",
        "Match": {
          "Path": "/payments-api/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/Payment/{**catch-all}" }
        ]
      }
    },
    "Clusters": {
      "game-cluster": {
        "Destinations": {
          "game-api": {
            "Address": "http://localhost:5177/"
          }
        }
      },
      "payment-cluster": {
        "Destinations": {
          "payment-api": {
            "Address": "http://localhost:5074/"
          }
        }
      }
    }
  }
}